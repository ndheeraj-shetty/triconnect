# Core settings
APP_NAME=EduSync API
APP_ENV=development
DEBUG=True
SECRET_KEY=supersecretkeythatsshouldbechangedinproduction12345
JWT_SECRET=anotherjwtsecretkeyforauthsigningshouldbechanged67890
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edusync

# File uploads
UPLOAD_DIRECTORY=uploads

# AI integrations
OPENAI_API_KEY=sk-placeholderopenaiapikeyformocking

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=placeholder@gmail.com
EMAIL_PASSWORD=app-specific-password
EMAIL_FROM=noreply@edusync.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
